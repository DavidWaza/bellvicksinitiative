# Copy to .env for local development (never commit .env). In production, set these in
# Vercel → Settings → Environment Variables. NUXT_PUBLIC_* are read at BUILD time: redeploy after
# changing them.

# --- Storybook AI covers -------------------------------------------------------------------------
# Draws each customer's three covers with OpenAI's GPT Image model (the model family Flick uses).
# Get a key at https://platform.openai.com/api-keys and set a monthly spend limit there.
NUXT_OPENAI_API_KEY=
# Turn the feature on for visitors (changes the photo-consent wording). Both must be set together.
NUXT_PUBLIC_STORYBOOK_AI_COVERS=0
# Optional: model (default gpt-image-2.5-sunburst, as used for the approved samples).
# NUXT_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Optional spending guards: cover SETS (3 images each) per visitor per day, and for the whole site.
# NUXT_STORYBOOK_COVERS_PER_IP=3
# NUXT_STORYBOOK_COVERS_PER_DAY=60

# --- Storybook shop (cart + Paystack checkout) ----------------------------------------------------
# Paystack SECRET key (Dashboard → Settings → API Keys & Webhooks). Start with sk_test_..., switch
# to sk_live_... when you go live. Never put it in front-end code or commit it.
NUXT_PAYSTACK_SECRET_KEY=
# Also set the webhook in Paystack (Settings → API Keys & Webhooks → Webhook URL), so paid orders
# are emailed even if the customer closes the tab: https://bellvicksinitiative.org/api/paystack/webhook
# Prices in naira. Leave empty (= not set) and checkout shows "price coming soon" and can't charge.
# A delivery fee of 0 means free delivery. NUXT_PUBLIC_* are read at BUILD time: rebuild after edits.
NUXT_PUBLIC_STORYBOOK_PRICE_NGN=
NUXT_PUBLIC_STORYBOOK_DELIVERY_NIGERIA_NGN=
NUXT_PUBLIC_STORYBOOK_DELIVERY_INTERNATIONAL_NGN=
# "Your order will arrive within N days" in the customer's receipt and on the confirmation page.
# NUXT_PUBLIC_STORYBOOK_DELIVERY_DAYS=10

# --- Site ------------------------------------------------------------------------------------------
# NUXT_PUBLIC_SITE_URL=https://bellvicksinitiative.org

# --- Form emails (Resend) --------------------------------------------------------------------------
# API key from https://resend.com/api-keys (the sending domain must be verified in Resend).
# Never put a real key in this example file: it is shared. The real one goes in .env / the host.
NUXT_RESEND_API_KEY=
# Storybook questionnaires (with the child's photo) and paid storybook orders go here:
NUXT_STORYBOOK_EMAIL=storybook@bellvicksinitiative.org
# Each form's inbox. Any left empty falls back to NUXT_CONTACT_EMAIL.
# Volunteer applications (and homepage sign-ups choosing "Volunteer"):
NUXT_VOLUNTEER_EMAIL=volunteer@bellvicksinitiative.org
# Mentor applications (and homepage sign-ups choosing "Become a mentor"):
NUXT_MENTOR_EMAIL=mentor@bellvicksinitiative.org
# Partnership enquiries (and homepage sign-ups choosing "Partner with us"):
NUXT_PARTNER_EMAIL=partner@bellvicksinitiative.org
# Donation pledges and Back to School sponsor applications:
NUXT_DONATIONS_EMAIL=donations@bellvicksinitiative.org
# Everything else: contact form, newsletter, Back to School recipient applications, "Not sure yet":
NUXT_CONTACT_EMAIL=info@bellvicksinitiative.org
# Optional: sender (default "Bellvicks Initiative website <website@bellvicksinitiative.org>").
# NUXT_EMAIL_FROM=

# --- Shared store (Vercel) ---------------------------------------------------------------------
# Vercel → Storage → Upstash Redis sets these automatically. Needed in production: order photos,
# "order already emailed" markers and the spam/spending limits must be shared between instances.
# Leave empty locally (memory is used).
KV_REST_API_URL=
KV_REST_API_TOKEN=
